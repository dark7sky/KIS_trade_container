# Host absolute persistent directory. Container receives /data automatically.
DATA_DIR=
KIS_DEMO_APP_KEY=
KIS_DEMO_APP_SECRET=
KIS_DEMO_ACCOUNT_NO=
KIS_DEMO_ACCOUNT_PRODUCT_CODE=
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_ACCOUNT_PRODUCT_CODE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=
ORDER_SUPERVISOR_INTERVAL_SECONDS=
# Origin only, e.g. https://mcp.example.com
MCP_PUBLIC_URL=
# e.g. https://login.example.com/realms/kis
OAUTH_ISSUER=
# A fresh UUID, also the ID of the single user imported into Keycloak.
OAUTH_ALLOWED_SUB=
# Keycloak external origin, e.g. https://login.example.com
KEYCLOAK_PUBLIC_URL=
CHATGPT_CLIENT_SECRET=
# Copy the exact callback URI shown by ChatGPT; do not use a wildcard.
CHATGPT_REDIRECT_URI=
TRADER_INITIAL_PASSWORD=
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=
# New server's private/VPN IP; never 0.0.0.0 for production.
PRIVATE_BIND_IP=
# Comma-separated exact trusted Nginx internal IPs.
TRUSTED_PROXY_IPS=
MCP_ALLOWED_ORIGINS=
