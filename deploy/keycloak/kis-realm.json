{
  "realm": "kis",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [{
    "clientId": "chatgpt-kis",
    "enabled": true,
    "protocol": "openid-connect",
    "publicClient": false,
    "secret": "${CHATGPT_CLIENT_SECRET}",
    "standardFlowEnabled": true,
    "implicitFlowEnabled": false,
    "directAccessGrantsEnabled": false,
    "serviceAccountsEnabled": false,
    "fullScopeAllowed": false,
    "redirectUris": ["${CHATGPT_REDIRECT_URI}"],
    "webOrigins": [],
    "attributes": {"pkce.code.challenge.method": "S256", "exclude.issuer.from.auth.response": "false"},
    "defaultClientScopes": ["basic", "profile", "email", "kis:access"],
    "protocolMappers": [{
      "name": "kis-resource-audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "config": {"included.custom.audience": "${MCP_PUBLIC_URL}/mcp", "access.token.claim": "true", "id.token.claim": "false"}
    }]
  }],
  "clientScopes": [
    {"name": "kis:access", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true", "display.on.consent.screen": "true"}},
    {"name": "basic", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "false"}, "protocolMappers": [
      {"name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": {"access.token.claim": "true", "introspection.token.claim": "true"}}
    ]},
    {"name": "profile", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}, "protocolMappers": [
      {"name": "username", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "username", "claim.name": "preferred_username", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
    ]},
    {"name": "email", "protocol": "openid-connect", "attributes": {"include.in.token.scope": "true"}, "protocolMappers": [
      {"name": "email", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "email", "claim.name": "email", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}},
      {"name": "email verified", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-property-mapper", "config": {"user.attribute": "emailVerified", "claim.name": "email_verified", "jsonType.label": "boolean", "access.token.claim": "true", "id.token.claim": "true", "userinfo.token.claim": "true"}}
    ]}
  ],
  "users": [{
    "id": "${OAUTH_ALLOWED_SUB}",
    "username": "trader",
    "enabled": true,
    "requiredActions": ["UPDATE_PASSWORD", "CONFIGURE_TOTP"],
    "credentials": [{"type": "password", "value": "${TRADER_INITIAL_PASSWORD}", "temporary": true}]
  }]
}
